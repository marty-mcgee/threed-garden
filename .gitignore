# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Retired duplicate Next.js declaration; next-env.d.ts is generated by Next.
/next-dev.d.ts

# Local generated SQL/snapshots; retained per the documented database workflow.
/drizzle

# Retained local reference assets and recovery journals (not disposable caches).
public/assets-archive
public/home-design
reference/

# Windows WSL Ubuntu download metadata
*:Zone.Identifier
# Windows misc
desktop.ini

# Local editor and AI-tool configuration (keep shared CI and tooling tracked).
/.claude/
/.codex/
/.cursor/
/.vscode/
/.mcp.json
/opencode.json
