{
  "name": "marty-mcgee-neon",
  "version": "0.20.11",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4444",
    "build": "next build",
    "start": "next start -p 4444",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "echo 'Use db:push for development'",
    "db:push": "drizzle-kit push --strict",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit --pretty false",
    "validate": "node src/libraries/scripts/validate.mjs",
    "validate:all": "node src/libraries/scripts/validate.mjs all",
    "threed:models:import": "node --import tsx src/libraries/scripts/import-threed-models.ts",
    "threed:models:import:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types src/libraries/scripts/validate-threed-model-import.mts",
    "threed:models:manifest:legacy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types src/libraries/scripts/generate-legacy-threed-model-manifest.mts",
    "multimedia:import": "bun run src/libraries/data/multimedia/seed.ts",
    "farmbot:mqtt-worker": "bun run src/libraries/services/threed/mqtt/integrations/farmbot/index.ts"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.470.0",
    "@aws-sdk/s3-request-presigner": "^3.470.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@vercel/blob": "^2.4.0",
    "@vercel/functions": "^3.3.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ecctrl": "^2.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.564.0",
    "mqtt": "^5.15.2",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.31",
    "node-cron": "^4.2.1",
    "pg": "^8.23.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "shadcn": "^3.8.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/next-auth": "^3.15.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.16",
    "axios": "^1.18.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.10",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
